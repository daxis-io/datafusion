    "test:exact:firefox": "DATAFUSION_EXACT_STACK=1 playwright test --project=firefox tests/exact-stack.spec.js",
    "test:exact:webkit": "DATAFUSION_EXACT_STACK=1 playwright test --project=webkit tests/exact-stack.spec.js",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit"
